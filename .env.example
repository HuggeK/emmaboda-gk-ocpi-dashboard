# Copy this file to `.env` and fill in the token you received from ChargeNode.
# `.env` is git-ignored; the token never leaves this machine.

# The OCPI token (Token A/C) issued by ChargeNode
OCPI_TOKEN=replace-me

# The OCPI "versions" endpoint of the CPO
OCPI_VERSIONS_URL=https://ocpi.chargenode.eu/ocpi/cpo/versions

# How the token is sent in the Authorization header.
#   auto   - try plain first, then base64 (OCPI 2.2+ style)
#   plain  - Authorization: Token <token>
#   base64 - Authorization: Token <base64(token)>
OCPI_TOKEN_ENCODING=auto

# Optional: OCPI version to prefer if the CPO offers several (default: 2.2.1)
# OCPI_PREFERRED_VERSION=2.2.1

# Optional: identify ourselves on OCPI 2.2+ (only if ChargeNode asks for it)
# OCPI_FROM_COUNTRY_CODE=SE
# OCPI_FROM_PARTY_ID=EGK

# Local HTTP port for the dashboard (binds to 127.0.0.1 only)
PORT=3000

# Set to 1 to run with generated demo data instead of calling ChargeNode
OCPI_DEMO=0
